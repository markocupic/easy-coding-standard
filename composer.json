{
    "name": "markocupic/easy-coding-standard",
    "description": "EasyCodingStandard configurations for Contao",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "authors": [
        {
            "name": "Marko Cupic",
            "homepage": "https://github.com/markocupic"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/easy-coding-standard": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\EasyCodingStandard\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
